# Copy to .env and fill in. .env is git-ignored and loaded automatically.
# Скопируйте в .env и заполните. .env не коммитится и подхватывается автоматически.
# Real environment variables take priority over .env / переменные окружения важнее .env.

# DeepSeek (OpenAI-compatible API): moments, translation, posts. Optional — without it a heuristic mode is used.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Telegram bot that receives the results (send only). Optional.
TG_BOT_TOKEN=123456789:your-bot-token
TG_CHAT_ID=your-chat-id

# Hugging Face token for pyannote speaker diarization. Optional.
HF_TOKEN=hf_your-token

# Interface language: ru | en
# KONVEYER_LANG=en
